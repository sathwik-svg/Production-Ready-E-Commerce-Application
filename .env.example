# GEMINI_API_KEY: Optional for AI Studio runtime
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="http://localhost:3000"

# ========================================================
# AWS DynamoDB Configuration (Optional for cloud deployment)
# If left empty, the application automatically uses the embedded
# persistent DynamoDB DocumentClient fallback engine.
# ========================================================
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
DYNAMODB_TABLE_NAME="ApexMegastoreTable"

# ========================================================
# Amazon Product Advertising API (PA-API v5) / SP-API
# If left empty, the application uses the built-in PA-API v5
# mock engine with live ASINs and price comparison.
# ========================================================
AMAZON_PAAPI_ACCESS_KEY=""
AMAZON_PAAPI_SECRET_KEY=""
AMAZON_ASSOCIATE_TAG="apexstore-20"
AMAZON_REGION="us-east-1"
AMAZON_HOST="webservices.amazon.com"
